{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (Debug)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/tiny-dns.sln",
                "-c",
                "Debug"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "build (Release)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceFolder}/tiny-dns.sln",
                "-c",
                "Release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "silent"
            }
        },
        {
            "label": "run sandbox (Debug)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/tiny-sandbox/tiny-sandbox.csproj",
                "-c",
                "Debug",
                "--no-build"
            ],
            "group": "none",
            "dependsOn": "build (Debug)",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "focus": true
            }
        },
        {
            "label": "test (Release)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/tiny-dns.sln",
                "-c",
                "Release",
                "--no-build"
            ],
            "group": "test",
            "dependsOn": "build (Release)",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "focus": false
            }
        },
        {
            "label": "run sandbox (Release)",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "run",
                "--project",
                "${workspaceFolder}/tiny-sandbox/tiny-sandbox.csproj",
                "-c",
                "Release",
                "--no-build"
            ],
            "group": "none",
            "dependsOn": "build (Release)",
            "problemMatcher": "$msCompile",
            "presentation": {
                "reveal": "always",
                "focus": true
            }
        }
    ]
}
